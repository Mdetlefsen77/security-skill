{
  "$comment": "Contrato de nivel superior para threat-register.json (ver phases/1-threat-model.md). validate-threat-register.cjs interpreta este schema con schema-engine.cjs y agrega las reglas semánticas: hash de threat_id, priority_tier derivado de la tabla, orden del registro, coherencia entre estado y evidencia.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "threat_id": {
        "type": "string",
        "pattern": "^[0-9a-f]{16}$",
        "description": "sha256 de 'actor::asset::invariant' (NFC) truncado a 16 caracteres hexadecimales."
      },
      "actor": { "type": "string", "minLength": 1, "visibleContent": true },
      "asset": { "type": "string", "minLength": 1, "visibleContent": true },
      "invariant": { "type": "string", "minLength": 1, "visibleContent": true },
      "why_it_matters": { "type": "string", "minLength": 1, "visibleContent": true },
      "candidate_starting_paths": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1 }
      },
      "initial_estimate": {
        "type": "object",
        "properties": {
          "likelihood": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "likelihood_reason": { "type": "string", "minLength": 1, "visibleContent": true },
          "impact": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "impact_reason": { "type": "string", "minLength": 1, "visibleContent": true },
          "priority_tier": { "type": "string", "enum": ["low", "medium", "high", "critical"] }
        },
        "required": ["likelihood", "likelihood_reason", "impact", "impact_reason", "priority_tier"],
        "additionalProperties": false
      },
      "current_estimate": {
        "type": "object",
        "properties": {
          "likelihood": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "impact": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "priority_tier": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "last_updated_wave": { "type": "integer", "minimum": 0 }
        },
        "required": ["likelihood", "impact", "priority_tier", "last_updated_wave"],
        "additionalProperties": false
      },
      "status": {
        "type": "string",
        "enum": ["queued", "in_progress", "investigated", "deferred", "closed_no_finding"]
      },
      "source": {
        "type": "string",
        "enum": ["reconnaissance", "hunter_discovered", "risk_critic_added", "cross_repo_pattern"]
      },
      "wave_assigned": { "type": ["integer", "null"] },
      "agent_id": { "type": ["string", "null"] },
      "reviewed_paths": {
        "type": "array",
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1 }
      },
      "checks": {
        "type": "array",
        "description": "Copiados por el padre desde el resultado del cazador (phases/2-hunting.md, Consolidación del padre).",
        "items": {
          "type": "object",
          "properties": {
            "agent_id": { "type": "string", "minLength": 1 },
            "reviewed_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "invariant_checked": { "type": "string", "minLength": 1, "visibleContent": true },
            "method": { "type": "string", "enum": ["source", "local"] },
            "result": { "type": "string", "minLength": 1, "visibleContent": true },
            "artifact": { "type": ["string", "null"] }
          },
          "required": ["agent_id", "invariant_checked", "method", "result", "artifact"],
          "additionalProperties": false
        }
      },
      "linked_candidate_fingerprints": {
        "type": "array",
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1 }
      },
      "unresolved": {
        "type": "array",
        "description": "Hechos sin resolver copiados del resultado del cazador.",
        "items": { "type": "string", "minLength": 1, "visibleContent": true }
      },
      "reassessment_log": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "wave": { "type": "integer", "minimum": 0 },
            "previous": {
              "type": "object",
              "properties": {
                "likelihood": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
                "impact": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
                "priority_tier": { "type": "string", "enum": ["low", "medium", "high", "critical"] }
              },
              "required": ["likelihood", "impact", "priority_tier"],
              "additionalProperties": false
            },
            "reason": { "type": "string", "minLength": 1, "visibleContent": true }
          },
          "required": ["wave", "reason"],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "threat_id",
      "actor",
      "asset",
      "invariant",
      "why_it_matters",
      "candidate_starting_paths",
      "initial_estimate",
      "current_estimate",
      "status",
      "source",
      "wave_assigned",
      "agent_id",
      "reviewed_paths",
      "linked_candidate_fingerprints",
      "reassessment_log"
    ],
    "additionalProperties": false
  }
}
